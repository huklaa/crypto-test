# Optional. Base's public RPC is used when this value is empty.
# For production, use a dedicated Base mainnet HTTPS endpoint from your provider.
VITE_BASE_RPC_URL=https://mainnet.base.org

# Public Base Sepolia endpoint used by the demo and Hardhat deployment.
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Set only in a local environment or CI secret store. Never commit this value.
BASE_SEPOLIA_PRIVATE_KEY=

# Filled after deploying PortfolioSnapshotRegistry.
VITE_SNAPSHOT_REGISTRY_ADDRESS=
